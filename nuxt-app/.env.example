# Режим БД: sqlite (локально, без Supabase) | mock | supabase
NUXT_DB=sqlite
# Путь к sqlite-файлу (по умолчанию ./data/demo.db)
NUXT_SQLITE_PATH=

NUXT_SUPABASE_URL=
NUXT_SUPABASE_PUBLISHABLE_KEY=
# Те же значения, но доступные клиенту (без NUXT_PUBLIC_* фронт их не увидит)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Клиентский флаг режима БД: sqlite | mock | supabase
NUXT_PUBLIC_DB_MODE=sqlite
NUXT_MCP_URL=
#NUXT_DEEPSEEK_API_KEY=# API-ключ Яндекс Карт (JS API v3, бесплатно до 500 запросов/сутки)
NUXT_PUBLIC_YANDEX_MAPS_KEY=
