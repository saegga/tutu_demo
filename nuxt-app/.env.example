# Режим БД: sqlite (локально) | mock (in-memory) | supabase
NUXT_DB=sqlite
# Путь к sqlite-файлу (по умолчанию ./data/demo.db)
NUXT_SQLITE_PATH=
# Клиентский флаг режима БД: sqlite | mock | supabase
NUXT_PUBLIC_DB_MODE=sqlite

# URL MCP-сервера Туту
NUXT_MCP_URL=

# API-ключ DeepSeek (для чат-агента)
NUXT_DEEPSEEK_API_KEY=
